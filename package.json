    "@prisma/client": "6.19.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "next": "16.4.6",
    "papaparse": "^5.5.3",
    "pdf-parse": "1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
