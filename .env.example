# Required: Neon pooled URL for app traffic; direct/non-pooled URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/solai?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/solai?sslmode=require"

# Required: Clerk application keys (public key is intentionally public).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
# Strongly recommended for this personal deployment. Obtain from Clerk dashboard.
OWNER_USER_ID=

# Required for encryption: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_VERSION=1
# Keep prior versions while rotating: ENCRYPTION_MASTER_KEY_V1=

# Exact origin, no trailing slash. Use your stable production domain.
APP_BASE_URL=http://localhost:3000
# Needed only for Gmail. Create a Web Application OAuth client in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback is derived: APP_BASE_URL + /api/gmail/callback

# Optional: authenticates Vercel cron or a separately hosted worker.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# No Gemini/Groq env keys: configure encrypted BYOK in the application.
